{
	"schemaVersion": 1,
	"id": "cakewood",
	"version": "${version}",
	"name": "CakeWood",
	"description": "Edible cake-wood blocks with bite mechanics, waxing, and multiple wood type variants.",
	"authors": [
		"deepinthewoods"
	],
	"contact": {
		"sources": "https://github.com/deepinthewoods/cakewood"
	},
	"license": "CC0-1.0",
	"icon": "assets/cakewood/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"ninja.trek.cakewood.CakeWood"
		],
		"client": [
			"ninja.trek.cakewood.CakeWoodClient"
		],
		"fabric-datagen": [
			"ninja.trek.cakewood.CakeWoodDataGenerator"
		]
	},
	"mixins": [
		"cakewood.mixins.json",
		{
			"config": "cakewood.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}